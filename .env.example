# Copy to .env.local and fill in. Never commit .env.local.

# Parliament API (authenticated, server-side only — never expose to the browser)
PARLIAMENT_API_BASE_URL=http://202.21.104.13/ParliamentAPI
PARLIAMENT_API_USERNAME=
PARLIAMENT_API_PASSWORD=

# LawForum API (public, read-only)
LAWFORUM_API_BASE_URL=https://lawforum.parliament.mn/LawForumAPI

# Public source URLs (safe to expose)
NEXT_PUBLIC_PARLIAMENT_SITE_URL=https://new.parliament.mn
NEXT_PUBLIC_LAWFORUM_SITE_URL=https://lawforum.parliament.mn
NEXT_PUBLIC_APP_NAME=Open Parliament

# Ask Parliament AI (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
